# Database (PostgreSQL via Docker, host port 5433)
DATABASE_URL="postgresql://userdatabase:passworddatabase@localhost:5433/pilketosdb"

# Secret untuk menandatangani session cookie admin (min. 32 karakter random hex).
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="718171c77e98b0ac70bc2171ebaf187eec0167838482552b6dc806a70f957bfe"

# S3-compatible object storage untuk foto kandidat.
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="candidate-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL publik bucket/CDN (opsional; default: S3_ENDPOINT/S3_BUCKET).
S3_PUBLIC_URL=""